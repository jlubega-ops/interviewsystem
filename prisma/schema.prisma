generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(uuid()) @db.VarChar(191)
  email             String          @unique
  username          String          @unique
  passwordHash      String          @map("password_hash")
  fullName          String          @map("full_name")
  firstName         String?         @map("first_name")
  middleName        String?         @map("middle_name")
  lastName          String?         @map("last_name")
  organisation      String?         @db.VarChar(255)
  role              Role
  isSuperadmin      Boolean         @default(false) @map("is_superadmin")
  cannotBeDeleted   Boolean         @default(false) @map("cannot_be_deleted")
  isActive          Boolean         @default(true) @map("is_active")
  isActivated       Boolean         @default(false) @map("is_activated")
  isSuspended       Boolean         @default(false) @map("is_suspended")
  suspensionReason  String?         @map("suspension_reason") @db.Text
  lastLoginAt       DateTime?       @map("last_login_at")
  profileCompletedAt DateTime?      @map("profile_completed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  phone             String?
  createdBy         String?         @map("created_by") @db.VarChar(191)
  createdCohorts    Cohort[]
  cohortExaminerAssignments CohortExaminer[]
  examinerAssignmentsMade   CohortExaminer[] @relation("ExaminerAssigner")
  createdInterviews Interview[]     @relation("InterviewCreator")
  updatedSettings   SystemSetting[]
  userSessions      UserSession[]
  passwordResetTokens PasswordResetToken[]
  activationTokens  AccountActivationToken[]
  createdQuestionBanks QuestionBank[]

  @@index([createdBy], map: "idx_users_created_by")
  @@map("users")
}

model QuestionBank {
  id        String   @id @default(uuid()) @db.VarChar(191)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  scope     QuestionBankScope @default(ALL_USERS)
  createdBy String   @map("created_by") @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator  User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  questions QuestionBankQuestion[]

  @@index([createdBy], map: "idx_question_banks_created_by")
  @@index([scope], map: "idx_question_banks_scope")
  @@map("question_banks")
}

model QuestionBankQuestion {
  id             String       @id @default(uuid()) @db.VarChar(191)
  questionBankId String       @map("question_bank_id") @db.VarChar(191)
  questionText   String       @db.Text @map("question_text")
  questionType   QuestionType @default(MULTIPLE_CHOICE) @map("question_type")
  options        Json?
  correctAnswer  String?      @db.Text @map("correct_answer")
  points         Int          @default(1)
  orderIndex     Int          @default(0) @map("order_index")
  createdAt      DateTime     @default(now()) @map("created_at")

  questionBank QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)

  @@index([questionBankId], map: "idx_question_bank_questions_bank_id")
  @@map("question_bank_questions")
}

model Interview {
  id              String        @id @default(uuid())
  description     String?       @db.Text
  createdBy       String        @map("created_by") @db.VarChar(191)
  durationMinutes Int           @default(60) @map("duration_minutes")
  totalQuestions  Int           @default(0) @map("total_questions")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  instructions    String?       @db.Text
  isHidden        Boolean       @default(false) @map("is_hidden")
  type            InterviewType @default(APTITUDE)

  // Relations
  creator         User              @relation("InterviewCreator", fields: [createdBy], references: [id])
  questions       Question[]
  candidateSessions CandidateSession[]
  cohortInterviews CohortInterview[]

  @@map("interviews")
}

model Cohort {
  id             String            @id @default(uuid()) @db.VarChar(191)
  name           String
  description    String?           @db.Text
  instructions   String?          @db.Text
  organisation   String?          @db.VarChar(255)
  openTime       DateTime         @map("open_time")
  closeTime      DateTime         @map("close_time")
  createdBy      String           @map("created_by") @db.VarChar(191)
  isActive       Boolean          @default(true) @map("is_active")
  isPublished     Boolean          @default(true) @map("is_published")
  resultsPublished Boolean        @default(false) @map("results_published")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  interviews   CohortInterview[]
  enrollments  CohortEnrollment[]
  examiners    CohortExaminer[]
  creator      User              @relation(fields: [createdBy], references: [id])

  @@index([createdBy], map: "cohorts_created_by_fkey")
  @@map("cohorts")
}

model CohortExaminer {
  id          String    @id @default(uuid()) @db.VarChar(191)
  cohortId    String    @map("cohort_id") @db.VarChar(191)
  userId      String    @map("user_id") @db.VarChar(191)
  assignedBy  String?   @map("assigned_by") @db.VarChar(191)
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  cohort      Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assigner    User?     @relation("ExaminerAssigner", fields: [assignedBy], references: [id])

  @@unique([cohortId, userId])
  @@index([cohortId], map: "idx_cohort_examiners_cohort_id")
  @@index([userId], map: "idx_cohort_examiners_user_id")
  @@index([assignedBy], map: "idx_cohort_examiners_assigned_by")
  @@map("cohort_examiners")
}

model Candidate {
  id          String             @id @default(uuid()) @db.VarChar(191)
  fullName    String             @map("full_name")
  email       String             @unique
  phone       String?
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  enrollments CohortEnrollment[]

  @@map("candidates")
}

model CohortEnrollment {
  id          String           @id @default(uuid()) @db.VarChar(191)
  cohortId    String           @map("cohort_id") @db.VarChar(191)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  status      EnrollmentStatus @default(ENROLLED)
  accessKey   String           @unique @map("access_key")
  candidateId String           @map("candidate_id") @db.VarChar(191)
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cohort      Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, candidateId])
  @@index([candidateId], map: "idx_cohort_enrollments_candidate_id")
  @@map("cohort_enrollments")
}

model CohortInterview {
  id            String        @id @default(uuid()) @db.VarChar(191)
  cohortId      String        @map("cohort_id") @db.VarChar(191)
  interviewId   String        @map("interview_id") @db.VarChar(191)
  createdAt     DateTime      @default(now()) @map("created_at")
  interviewType InterviewType
  cohort        Cohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  interview     Interview     @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([cohortId, interviewId])
  @@map("cohort_interviews")
}

model Question {
  id               String            @id @default(uuid())
  interviewId      String            @map("interview_id")
  questionText     String            @db.Text @map("question_text")
  questionType     QuestionType      @default(MULTIPLE_CHOICE) @map("question_type")
  options          Json?
  correctAnswer    String?           @db.Text @map("correct_answer")
  points           Int               @default(1)
  orderIndex       Int               @default(0) @map("order_index")
  createdAt        DateTime          @default(now()) @map("created_at")
  candidateAnswers CandidateAnswer[]
  interview        Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model CandidateSession {
  id                String            @id @default(uuid())
  interviewId       String            @map("interview_id")
  candidateName     String            @map("candidate_name")
  candidateEmail    String?           @map("candidate_email")
  accessKey         String            @map("access_key")
  status            SessionStatus     @default(STARTED)
  startedAt         DateTime          @default(now()) @map("started_at")
  completedAt       DateTime?         @map("completed_at")
  score             Int               @default(0)
  totalQuestions    Int               @default(0) @map("total_questions")
  answeredQuestions Int               @default(0) @map("answered_questions")
  leaveAttempts     Int               @default(5) @map("leave_attempts")
  submissionReason  String?           @map("submission_reason")
  candidateAnswers  CandidateAnswer[]
  interview         Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([accessKey, interviewId], name: "unique_attempt_per_interview")
  @@map("candidate_sessions")
}

model CandidateAnswer {
  id         String           @id @default(uuid())
  sessionId  String           @map("session_id")
  questionId String           @map("question_id")
  answer     String?          @db.Text
  isCorrect  Boolean          @default(false) @map("is_correct")
  answeredAt DateTime         @default(now()) @map("answered_at")
  typingStats Json?           @map("typing_stats")
  question   Question         @relation(fields: [questionId], references: [id])
  session    CandidateSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId], name: "unique_answer_per_question")
  @@index([questionId], map: "idx_candidate_answers_question_id")
  @@map("candidate_answers")
}

model SystemSetting {
  id           String   @id @default(uuid())
  settingKey   String   @unique @map("setting_key")
  settingValue String?  @map("setting_value")
  description  String?
  updatedBy    String?  @map("updated_by") @db.VarChar(191)
  updatedAt    DateTime @updatedAt @map("updated_at")
  updater      User?    @relation(fields: [updatedBy], references: [id])

  @@index([updatedBy], map: "system_settings_updated_by_fkey")
  @@map("system_settings")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id") @db.VarChar(191)
  sessionId    String   @unique @map("session_id")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  loginTime    DateTime @default(now()) @map("login_time")
  lastActivity DateTime @default(now()) @updatedAt @map("last_activity")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_sessions_user_id")
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.VarChar(191)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@index([token], map: "idx_password_reset_tokens_token")
  @@map("password_reset_tokens")
}

model AccountActivationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.VarChar(191)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_account_activation_tokens_user_id")
  @@index([token], map: "idx_account_activation_tokens_token")
  @@map("account_activation_tokens")
}

model ActivityLog {
  id                 String   @id @default(uuid()) @db.VarChar(191)
  actorType          String   @map("actor_type") @db.VarChar(20)
  userId             String?  @map("user_id") @db.VarChar(191)
  actorName          String?  @map("actor_name") @db.VarChar(255)
  actorEmail         String?  @map("actor_email") @db.VarChar(255)
  actorOrg           String?  @map("actor_org") @db.VarChar(255)
  actorRole          String?  @map("actor_role") @db.VarChar(50)
  actionType         String   @map("action_type") @db.VarChar(100)
  resource           String?  @map("resource") @db.VarChar(100)
  description        String   @db.Text
  ipAddress          String?  @map("ip_address") @db.VarChar(45)
  userAgent          String?  @map("user_agent") @db.VarChar(500)
  candidateId        String?  @map("candidate_id") @db.VarChar(191)
  targetCohortId     String?  @map("target_cohort_id") @db.VarChar(191)
  targetCohortName   String?  @map("target_cohort_name") @db.VarChar(255)
  targetInterviewId  String?  @map("target_interview_id") @db.VarChar(191)
  targetInterviewType String? @map("target_interview_type") @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_activity_logs_created_at")
  @@index([actionType], map: "idx_activity_logs_action_type")
  @@index([userId], map: "idx_activity_logs_user_id")
  @@index([candidateId], map: "idx_activity_logs_candidate_id")
  @@index([actorEmail], map: "idx_activity_logs_actor_email")
  @@index([actorOrg], map: "idx_activity_logs_actor_org")
  @@map("activity_logs")
}

enum Role {
  SUPERADMIN
  ADMIN
  EXAMINER
  FACILITATOR
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  TEXT
  TYPING
}

enum SessionStatus {
  STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum EnrollmentStatus {
  ENROLLED
  UNENROLLED
  COMPLETED
}

enum InterviewType {
  APTITUDE
  TYPING
  ORAL
}

enum QuestionBankScope {
  ALL_USERS   // admin and examiners
  ADMIN_ONLY  // only admin (and superadmin)
  PRIVATE     // only creator
}
