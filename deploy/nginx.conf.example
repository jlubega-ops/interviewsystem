# Example nginx front for this Next.js interview app.
# Cache static files at nginx. Do NOT cache /api — answers, sessions, and
# access keys are per-student and must not be shared across users.

upstream interview_app {
    server 127.0.0.1:3000;
    keepalive 64;
}

# Optional disk cache used only for hashed Next assets and images.
proxy_cache_path /var/cache/nginx/interview
    levels=1:2
    keys_zone=interview_static:20m
    max_size=1g
    inactive=7d
    use_temp_path=off;

server {
    listen 443 ssl http2;
    server_name interviews.example.com;

    # ssl_certificate     /etc/ssl/certs/interviews.crt;
    # ssl_certificate_key /etc/ssl/private/interviews.key;

    client_max_body_size 20m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /_next/static/ {
        proxy_pass http://interview_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_cache interview_static;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Cache-Status $upstream_cache_status;
    }

    location /images/ {
        proxy_pass http://interview_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_cache interview_static;
        proxy_cache_valid 200 1d;
        add_header Cache-Control "public, max-age=86400, stale-while-revalidate=604800";
        add_header X-Cache-Status $upstream_cache_status;
    }

    location /api/ {
        proxy_pass http://interview_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_cache off;
        add_header Cache-Control "private, no-store";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        proxy_pass http://interview_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
        proxy_read_timeout 60s;
    }
}
